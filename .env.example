# ==============================================================================
# CineData Analytics GenAI - Variáveis de Ambiente
# Copie para `.env` e preencha ao menos UMA chave de provedor.
# ==============================================================================

# Ordem fixa: Gemini primeiro. O OpenRouter gratuito entra só se o Gemini falhar.
# Quantas chaves Gemini quiser, separadas por vírgula. Chave vazia é pulada; repetida é ignorada.

# Google Gemini.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite

# Último recurso: OpenRouter (modelos :free, 50 req/dia na conta gratuita)
OPENROUTER_API_KEY=
# Ordem interna do OpenRouter, separada por vírgula. Um 429 de pool lotado pula para o próximo.
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,openrouter/free

# Banco SQLite da camada Gold. Se vazio, procura em data/cinerocket.db,
# cinerocket.db e cinerocket-db/ (caminhos relativos à raiz do projeto).
CINEROCKET_DB_PATH=

# Limites de execução SQL
SQL_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=200

# Comportamento do agente
AGENT_MAX_SQL_RETRIES=2
# Caminho feliz gasta 2 (pedir o SQL e responder depois de ver as linhas). 6 ainda cabe uma consulta refeita.
AGENT_MAX_LLM_REQUESTS=6
# Ignorado (ADR 013). A resposta em linguagem natural sai do ciclo da ferramenta.
AGENT_NARRATE=true
AGENT_CACHE_ENABLED=true
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Origens do frontend, separadas por vírgula. Vazio recusa o navegador.
# Exemplo: http://localhost:5173
CORS_ORIGINS=

# Observabilidade opcional (pip install -e ".[observability]")
LOGFIRE_TOKEN=
